{
  "name": "unityweb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unity Web Clone — a TypeScript/three.js runtime that opens real Unity scenes and prefabs and renders them, for headless visual verification and in-browser inspection.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5180",
    "build": "vite build",
    "shot": "node scripts/shot.mjs",
    "harness": "node scripts/harness.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "tsc --noEmit && npm test"
  },
  "dependencies": {
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "^0.169.0",
    "playwright-core": "1.49.1",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
